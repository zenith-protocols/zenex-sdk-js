{
    "name": "@zenith-protocols/zenex-sdk",
    "version": "1.0.0",
    "description": "Javascript SDK for Zenex",
    "scripts": {
        "clean": "rimraf dist",
        "build:cjs": "npx tsc -p ./scripts/tsconfig.cjs.json",
        "build:esm": "npx tsc -p ./scripts/tsconfig.esm.json",
        "build:types": "npx tsc -p ./scripts/tsconfig.types.json",
        "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:types",
        "test": "jest --config ./scripts/jest.config.js"
    },
    "exports": {
        "require": "./dist/cjs/index.js",
        "import": "./dist/esm/index.js",
        "types": "./dist/types/index.d.ts"
    },
    "typings": "dist/types/index.d.ts",
    "files": [
        "/dist"
    ],
    "publishConfig": {
        "access": "public",
        "tag": "beta"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zenith-protocols/zenex-sdk-js.git"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/zenith-protocols/zenex-sdk-js/issues"
    },
    "homepage": "https://github.com/zenith-protocols/zenex-sdk-js#readme",
    "devDependencies": {
        "@types/jest": "^29.5.0",
        "@typescript-eslint/eslint-plugin": "^5.59.0",
        "@typescript-eslint/parser": "^5.59.0",
        "eslint": "^8.38.0",
        "eslint-config-prettier": "^8.8.0",
        "eslint-plugin-prettier": "^4.2.1",
        "jest": "^29.5.0",
        "prettier": "^2.8.7",
        "ts-jest": "^29.1.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.1.6"
    },
    "dependencies": {
        "@stellar/stellar-sdk": "13.2.0"
    }
}